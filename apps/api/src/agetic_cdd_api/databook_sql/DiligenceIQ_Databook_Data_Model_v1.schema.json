{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://diligenceiq/schemas/databook/1.0.0",
 "title": "DiligenceIQ databook data model",
 "description": "Entities of the databook fact store, for APIs and messages. Same rules as databook_postgres.sql. Concept ids, dimensions, units and document types are governed by the ontology.",
 "$defs": {
  "deal_profile": {
   "type": "object",
   "required": [
    "deal_id",
    "ontology_version",
    "reporting_currency",
    "fiscal_year_end",
    "latest_actual_month",
    "sector_packs",
    "ebitda_policy"
   ],
   "properties": {
    "deal_id": {
     "type": "string"
    },
    "deal_name": {
     "type": "string"
    },
    "target_entity": {
     "type": "string"
    },
    "ontology_version": {
     "type": "string",
     "description": "ontology version the row was built with"
    },
    "reporting_currency": {
     "type": "string",
     "pattern": "^[A-Z]{3}$"
    },
    "fiscal_year_end": {
     "type": "string",
     "pattern": "^(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$",
     "description": "MM-DD"
    },
    "latest_actual_month": {
     "type": "string",
     "format": "date",
     "description": "Last month-end with actuals; drives YTD, LTM and the basis window."
    },
    "history_years": {
     "type": "integer",
     "minimum": 1,
     "default": 3
    },
    "sector_packs": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "ebitda_policy": {
     "type": "object",
     "properties": {
      "include_other_operating_income": {
       "type": "boolean"
      },
      "rent_basis": {
       "enum": [
        "GAAP",
        "CASH"
       ]
      },
      "bad_debt_in_ebitda": {
       "type": "boolean"
      }
     }
    },
    "materiality": {
     "type": "number"
    },
    "confirmed_by": {
     "type": "string"
    },
    "confirmed_at": {
     "type": "string",
     "format": "date-time"
    }
   }
  },
  "document": {
   "type": "object",
   "required": [
    "doc_id",
    "deal_id",
    "ontology_version",
    "file_name",
    "format",
    "doc_type",
    "status"
   ],
   "properties": {
    "doc_id": {
     "type": "string"
    },
    "deal_id": {
     "type": "string"
    },
    "ontology_version": {
     "type": "string",
     "description": "ontology version the row was built with"
    },
    "file_name": {
     "type": "string"
    },
    "path": {
     "type": "string"
    },
    "format": {
     "enum": [
      "xlsx",
      "xls",
      "csv",
      "pdf",
      "pptx",
      "docx",
      "txt",
      "image",
      "other"
     ]
    },
    "doc_type": {
     "enum": [
      "FIN_AUDITED_FS",
      "FIN_REVIEWED_FS",
      "FIN_MGMT_ACCOUNTS",
      "FIN_TRIAL_BALANCE",
      "FIN_GENERAL_LEDGER",
      "FIN_TAX_RETURN",
      "FIN_BUDGET",
      "FIN_MGMT_MODEL",
      "FIN_INVESTOR_WORKBOOK",
      "FIN_QOE_REPORT",
      "FIN_FDD_REPORT",
      "FIN_FIXED_ASSET_REGISTER",
      "DEBT_LOAN_AGREEMENT",
      "DEBT_LENDER_STATEMENT",
      "DEBT_SCHEDULE",
      "LEASE_AGREEMENT",
      "LEASE_SCHEDULE",
      "CAP_TABLE",
      "SECURITIES_LEDGER",
      "CONTRACT_CUSTOMER",
      "CONTRACT_SUPPLIER",
      "CONTRACT_GRANT",
      "KPI_SYSTEM_EXTRACT",
      "KPI_CUSTOMER_LIST",
      "KPI_MGMT_REPORT",
      "HR_PAYROLL_EXTRACT",
      "MKT_SIZING_MODEL",
      "MKT_THIRD_PARTY_REPORT",
      "MKT_PUBLIC_DATA",
      "MKT_SURVEY_DATA",
      "MKT_INTERVIEW_NOTES",
      "MKT_COMPETITOR_INFO",
      "MKT_WEB_RESEARCH",
      "CIM",
      "TEASER",
      "PROCESS_LETTER",
      "DEAL_TERM_SHEET",
      "DEAL_SPA",
      "DEAL_MODEL",
      "APPRAISAL",
      "LEGAL_DD_REPORT",
      "ESG_REPORT",
      "MARKETING_MATERIAL",
      "CORPORATE_DOCS",
      "POINTER_NOTE",
      "AGENT_OUTPUT",
      "CALCULATED"
     ]
    },
    "doc_type_confidence": {
     "type": "number",
     "minimum": 0,
     "maximum": 1
    },
    "version_group": {
     "type": "string"
    },
    "version_rank": {
     "type": "integer",
     "minimum": 1
    },
    "is_primary": {
     "type": "boolean"
    },
    "in_data_room": {
     "type": "boolean"
    },
    "pointer_target_doc_id": {
     "type": [
      "string",
      "null"
     ]
    },
    "basis_default": {
     "enum": [
      "ACTUAL",
      "BUDGET",
      "FORECAST",
      "MGMT_CASE",
      "PRO_FORMA",
      "ADJUSTED",
      "MARKET_ESTIMATE",
      "SURVEY"
     ]
    },
    "evidence_tier": {
     "enum": [
      "A",
      "B",
      "C"
     ]
    },
    "period_end": {
     "type": [
      "string",
      "null"
     ],
     "format": "date"
    },
    "status": {
     "enum": [
      "READ",
      "PARTIAL",
      "SKIPPED",
      "FAILED"
     ]
    },
    "status_reason": {
     "type": [
      "string",
      "null"
     ]
    },
    "facts_count": {
     "type": "integer"
    },
    "sha256": {
     "type": "string"
    }
   }
  },
  "source_location": {
   "type": "object",
   "required": [
    "location_id",
    "doc_id",
    "extraction_method"
   ],
   "properties": {
    "location_id": {
     "type": "string"
    },
    "doc_id": {
     "type": "string"
    },
    "sheet_or_page": {
     "type": "string"
    },
    "table_id": {
     "type": [
      "string",
      "null"
     ]
    },
    "cell_range": {
     "type": [
      "string",
      "null"
     ],
     "description": "A1 range for spreadsheets"
    },
    "bbox": {
     "type": [
      "array",
      "null"
     ],
     "items": {
      "type": "number"
     },
     "description": "x0,y0,x1,y1 for PDF and slides"
    },
    "row_label_as_read": {
     "type": [
      "string",
      "null"
     ]
    },
    "column_label_as_read": {
     "type": [
      "string",
      "null"
     ]
    },
    "value_as_read": {
     "type": [
      "string",
      "null"
     ]
    },
    "extraction_method": {
     "enum": [
      "STATEMENT_READER",
      "REGISTER_READER",
      "COHORT_READER",
      "KPI_TABLE_READER",
      "PDF_TABLE",
      "PDF_TEXT",
      "SLIDE_TABLE",
      "SLIDE_CHART",
      "OCR",
      "LLM_EXTRACT",
      "USER"
     ]
    },
    "transform_steps": {
     "type": "array",
     "items": {
      "type": "string"
     },
     "description": "e.g. scale x1000, sign flip"
    }
   }
  },
