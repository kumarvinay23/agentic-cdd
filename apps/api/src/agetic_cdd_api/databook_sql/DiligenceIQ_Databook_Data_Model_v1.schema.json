      "string",
      "null"
     ]
    }
   },
   "allOf": [
    {
     "if": {
      "properties": {
       "unit_type": {
        "const": "CURRENCY"
       }
      }
     },
     "then": {
      "required": [
       "currency"
      ]
     }
    },
    {
     "if": {
      "properties": {
       "period_type": {
        "const": "FY"
       }
      }
     },
     "then": {
      "properties": {
       "months_covered": {
        "const": 12
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "period_type": {
        "const": "YTD"
       }
      }
     },
     "then": {
      "properties": {
       "months_covered": {
        "maximum": 11,
        "minimum": 1
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "status": {
        "enum": [
         "HELD",
         "REJECTED",
         "COMPARATIVE"
        ]
       }
      }
     },
     "then": {
      "required": [
       "reason_code"
      ]
     }
    },
    {
     "if": {
      "properties": {
       "status": {
        "const": "DERIVED"
       }
      }
     },
     "then": {
      "required": [
       "derived_from",
       "formula"
      ],
      "properties": {
       "derived_from": {
        "minItems": 1
       }
      }
     },
     "else": {
      "required": [
       "source_location_ids"
      ],
      "properties": {
       "source_location_ids": {
        "minItems": 1
       }
      }
     }
    }
   ]
  },
