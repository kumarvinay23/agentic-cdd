   "type": "object",
   "required": [
    "fact_id",
    "deal_id",
    "entity_id",
    "concept_id",
    "value",
    "unit_type",
    "period_type",
    "basis",
    "dimensions",
    "status",
    "evidence_tier",
    "ontology_version"
