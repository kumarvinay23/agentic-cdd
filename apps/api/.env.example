# Local API env (W1+)
# development → localhost/127.0.0.1 any port allowed via regex (no need to list :3001).
# production  → set AGETIC_CDD_APP_ENV=production and HTTPS UI origins only (no *).
AGETIC_CDD_APP_ENV=development
AGETIC_CDD_CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
AGETIC_CDD_HOST=127.0.0.1
AGETIC_CDD_PORT=4600
AGETIC_CDD_JWT_SECRET=dev-only-change-me-agetic-cdd-jwt-secret-32b
# Optional override; default is apps/api/data/deals
# AGETIC_CDD_DEALS_STORAGE_PATH=/absolute/path/to/deals
AGETIC_CDD_SEED_ADMIN_EMAIL=admin@ageticcdd.com
AGETIC_CDD_SEED_ADMIN_PASSWORD=adminpass
AGETIC_CDD_SEED_ORG_NAME=Agentic CDD Workspace

# LLM provider for Document Workspace / Deep Dive / FIN discovery (restart API after change)
# AGETIC_CDD_LLM_PROVIDER=gemini
# AGETIC_CDD_LLM_MODEL=
# AGETIC_CDD_LLM_API_KEY=
# AGETIC_CDD_DOCUMENT_SYNTHESIS_LLM=true
#
# Per-request overrides (no restart): JSON body ``llm: {provider, model, api_key}``
# or headers X-Agetic-LLM-Provider / X-Agetic-LLM-Model / X-Agetic-LLM-API-Key
# on POST …/pipeline/run and POST …/documents/messages. Response includes ``llm``
# selection; ``llm_invoked`` / ranker.invocation show which provider was called.
#
# Gemini (default when LLM_PROVIDER=gemini)
# AGETIC_CDD_GEMINI_API_KEY=
# AGETIC_CDD_GEMINI_MODEL=gemini-3.6-flash
#
# OpenAI (set LLM_PROVIDER=openai)
# AGETIC_CDD_OPENAI_API_KEY=
# AGETIC_CDD_OPENAI_MODEL=gpt-4o-mini
# AGETIC_CDD_OPENAI_BASE_URL=https://api.openai.com/v1
#
# Anthropic (set LLM_PROVIDER=anthropic)
# AGETIC_CDD_ANTHROPIC_API_KEY=
# AGETIC_CDD_ANTHROPIC_MODEL=claude-sonnet-4-5

# Deep Dive hybrid refine (customer_satisfaction / buying_behavior). Default off.
# Soak before enabling in prod:
#   cd apps/api && python scripts/run_deep_dive_llm_soak.py
#   cd apps/api && python scripts/run_deep_dive_llm_soak.py --live   # needs API key
# AGETIC_CDD_DEEP_DIVE_LLM=false

# Gate 2 miss only: discover/promote likely FIN_* files (default off; no hot-path LLM).
# Quality harden: zero-only / no-improvement promotes are reverted automatically.
# AGETIC_CDD_FIN_DISCOVERY_ON_GATE2_MISS=false

# Databook Postgres (ontology facts). Pass from any env / secret manager.
# Option A — full DSN (wins when set):
AGETIC_CDD_DATABOOK_DATABASE_URL=postgresql://127.0.0.1:5433/agetic_cdd_databook
# Option B — discrete knobs (used only when the URL above is empty):
# AGETIC_CDD_DATABOOK_DB_HOST=127.0.0.1
# AGETIC_CDD_DATABOOK_DB_PORT=5433
# AGETIC_CDD_DATABOOK_DB_NAME=agetic_cdd_databook
# AGETIC_CDD_DATABOOK_DB_USER=
# AGETIC_CDD_DATABOOK_DB_PASSWORD=
