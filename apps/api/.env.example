# Local API env (W1+)
# development → localhost/127.0.0.1 any port allowed via regex (no need to list :3001).
# production  → set AGETIC_CDD_APP_ENV=production and HTTPS UI origins only (no *).
AGETIC_CDD_APP_ENV=development
AGETIC_CDD_CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
AGETIC_CDD_HOST=127.0.0.1
AGETIC_CDD_PORT=4600
AGETIC_CDD_JWT_SECRET=dev-only-change-me-agetic-cdd-jwt-secret-32b
# Optional override; default is apps/api/data/deals
# AGETIC_CDD_DEALS_STORAGE_PATH=/absolute/path/to/deals
AGETIC_CDD_SEED_ADMIN_EMAIL=admin@ageticcdd.com
AGETIC_CDD_SEED_ADMIN_PASSWORD=adminpass
AGETIC_CDD_SEED_ORG_NAME=Agentic CDD Workspace

# Document Workspace LLM synthesis (optional — heuristic fallback if unset)
# AGETIC_CDD_GEMINI_API_KEY=
# AGETIC_CDD_GEMINI_MODEL=gemini-3.6-flash
# AGETIC_CDD_DOCUMENT_SYNTHESIS_LLM=true
